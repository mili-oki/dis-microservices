# Production Environment Variables
# Copy this file to .env.prod and update the values

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-here-1234567890

# Database URLs
AUTH_DB_URL=jdbc:postgresql://postgres-auth:5432/authdb
AUTH_DB_NAME=authdb
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=your-secure-auth-password

CATALOG_DB_URL=jdbc:postgresql://postgres-catalog:5432/catalogdb
CATALOG_DB_NAME=catalogdb
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=your-secure-catalog-password

ORDERS_DB_URL=jdbc:postgresql://postgres-orders:5432/ordersdb
ORDERS_DB_NAME=ordersdb
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=your-secure-orders-password

PAYMENTS_DB_URL=jdbc:postgresql://postgres-payments:5432/paymentsdb
PAYMENTS_DB_NAME=paymentsdb
PAYMENTS_DB_USER=payments
PAYMENTS_DB_PASSWORD=your-secure-payments-password

# RabbitMQ Settings
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASS=your-secure-rabbitmq-password

# Grafana Settings
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password
